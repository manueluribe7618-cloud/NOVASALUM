# Copia este archivo como .streamlit/secrets.toml y pon las credenciales reales.
# NUNCA subas secrets.toml a GitHub: ya esta en .gitignore.
#
# Una credencial por empresa. El nombre despues de SIIGO_ debe coincidir con el
# codigo de empresa que use la aplicacion (NOVASA, LUAC, MSU).

SIIGO_PARTNER_ID = "NovaLogistics"

SIIGO_NOVASA_USERNAME = "usuario@empresa.com"
SIIGO_NOVASA_ACCESS_KEY = "..."

SIIGO_LUAC_USERNAME = "usuario@empresa.com"
SIIGO_LUAC_ACCESS_KEY = "..."

SIIGO_MSU_USERNAME = "usuario@empresa.com"
SIIGO_MSU_ACCESS_KEY = "..."

# --- Supabase (cartera manual en la nube) -----------------------------------
# Sin esta llave, las facturas se guardan en el archivo local novasalum.db.
# Con ella, todo se guarda en Supabase (obligatorio para Streamlit Cloud,
# donde el disco se borra en cada reinicio).
#
# En supabase.com: tu proyecto -> Connect -> ORMs/URI. Usa la URI del
# "Transaction pooler" (puerto 6543) y reemplaza [YOUR-PASSWORD] por la
# contrasena de la base de datos del proyecto.

# SUPABASE_DB_URL = "postgresql://postgres.abcdefgh:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
