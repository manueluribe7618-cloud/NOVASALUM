# Copia este archivo como .streamlit/secrets.toml y pon las credenciales reales.
# NUNCA subas secrets.toml a GitHub: ya esta en .gitignore.
#
# Una credencial por empresa. El nombre despues de SIIGO_ debe coincidir con el
# codigo de empresa que use la aplicacion (NOVASA, LUAC, MSU).

SIIGO_PARTNER_ID = "NovaLogistics"

SIIGO_NOVASA_USERNAME = "usuario@empresa.com"
SIIGO_NOVASA_ACCESS_KEY = "..."

SIIGO_LUAC_USERNAME = "usuario@empresa.com"
SIIGO_LUAC_ACCESS_KEY = "..."

SIIGO_MSU_USERNAME = "usuario@empresa.com"
SIIGO_MSU_ACCESS_KEY = "..."
